--- /dev/null
+++ b/tests/fixtures/state_handheld_bridge.c
@@ -0,0 +1,27 @@
+/* Reuse the firmware team's host-only parser, never compile this into the DSP. */
+#include "climate_smoke.c"
+
+static struct readout sim;
+
+void sim_reset(void) { sim = (struct readout){0}; }
+void sim_open(uint8_t screen, uint32_t generation, uint8_t frame[REQUEST_SIZE])
+{
+    request_snapshot(&sim, screen, generation, frame);
+}
+void sim_close(uint8_t frame[REQUEST_SIZE]) { close_screen(&sim, frame); }
+void sim_link_lost(void) { sim.status = STALE; }
+int sim_receive(const uint8_t *data, size_t size) { return receive_state(&sim, data, size); }
+int sim_status(void) { return sim.status; }
+int sim_sequence(void) { return sim.sequence; }
+
+int sim_type(unsigned field) { return sim.fields[field - 1].type; }
+int sim_value(unsigned field)
+{
+    const struct field *item = &sim.fields[field - 1];
+    if (item->type == TEMPERATURE)
+        return signed_le16(item->value + 1);
+    if (item->type == NUMBER)
+        return signed_le16(item->value);
+    return item->value[0];
+}
+int sim_unit(unsigned field) { return sim.fields[field - 1].value[0]; }
