+from custom_components.ununiversal_remote.state_protocol import CONTROL_PREFIX, OPEN
+from custom_components.ununiversal_remote.stock import STOCK_HANDHELD_MODE, V1_PREFIX
+from custom_components.ununiversal_remote.view_state import Field
+
+CLOSED, WAITING, CURRENT, STALE = range(4)
+
+
+class TestStateProvider(IsolatedAsyncioTestCase):
+    @classmethod
+    def setUpClass(cls):
+        build = TemporaryDirectory()
+        cls.addClassCleanup(build.cleanup)
+        candidate = Path(environ.get("HANDHELD_DSP_FIXTURE",
+            "firmware/dsp-v48-native-menu/climate_smoke.c")).resolve()
+        if not candidate.is_file() or candidate.name != "climate_smoke.c":
+            raise ValueError("Set HANDHELD_DSP_FIXTURE to the repository's climate_smoke.c")
+        binary = Path(build.name) / "receiver.so"
+        bridge = Path(__file__).parent / "fixtures" / "state_handheld_bridge.c"
+        run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror", "-shared", "-fPIC",
+             "-I", str(candidate.parent), str(bridge), "-o", str(binary)], check=True)
+        cls.native = CDLL(str(binary))
+        cls.native.sim_open.argtypes = [c_uint8, c_uint32, c_char_p]
+        cls.native.sim_close.argtypes = [c_char_p]
+        cls.native.sim_receive.argtypes = [c_char_p, c_size_t]
+
+    async def asyncSetUp(self):
+        self.native.sim_reset()
+        temp = TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.hass = HomeAssistant(temp.name)
+        entry = ConfigEntry(title="Offline state", domain=DOMAIN, version=1, minor_version=1,
+            source="user", entry_id="offline_state", unique_id=None, discovery_keys=MappingProxyType({}),
+            subentries_data=(), data={"remote_id": "offline"}, options={"ble_mode": STOCK_HANDHELD_MODE})
+        self.remote = Remote(self.hass, entry)
+        self.ble = SimpleNamespace(client=None, active=None)
+        self.ble.is_active = MethodType(BleRemote.is_active, self.ble)
+        self.remote.ble = self.ble
+        self.frames = []
+        self.deliveries = []
+        self.drop_next = False
+        self.reconnect()
+        self.no_actions = AsyncMock(side_effect=AssertionError("State feed must never invoke a service"))
+        mock = patch.object(type(self.hass.services), "async_call", new=self.no_actions)
+        mock.start()
+        self.addCleanup(mock.stop)
+        self.action_events = []
+        self.addCleanup(self.hass.bus.async_listen("ununiversal_remote_input", self.action_events.append))
+
+    def reconnect(self, *, screens=None, sender=None):
+        peer = SimpleNamespace(is_connected=True)
+        self.client = self.ble.client = peer
+        self.ble.active = object()
