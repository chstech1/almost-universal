+        self.addCleanup(self.provider.async_close)
+        return self.provider
+
+    async def send(self, client, data):
+        assert client is self.client
+        self.frames.append((self.hass.loop.time(), data))
+        if self.drop_next:
+            self.drop_next = False
+            return
+        self.deliveries.append(bool(self.native.sim_receive(data, len(data))))
