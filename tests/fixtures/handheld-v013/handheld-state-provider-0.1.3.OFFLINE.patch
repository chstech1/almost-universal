@@ -0,0 +1,91 @@
+"""Home Assistant event provider for an externally owned state session."""
+
+import asyncio
+import logging
+
+from homeassistant.core import callback
+from homeassistant.helpers.event import async_track_state_change_event
+
+LOGGER = logging.getLogger(__name__)
+
+
+class HAStateProvider:
+    """Subscribe only for the active view, with one timer and writer per link."""
+
+    def __init__(self, hass, entry, session):
+        self._hass = hass
+        self._entry = entry
+        self._session = session
+        self._unlisten = None
+        self._timer = None
+        self._task = None
+        self._closed = False
+
+    @callback
+    def async_receive(self, frame):
+        if self._closed or not self._session.is_active():
+            self.async_close()
+            return False
+        if not self._session.receive(frame):
+            return False
+        self._detach()
+        entities = self._session.view.entities
+        if entities:
+            self._unlisten = async_track_state_change_event(self._hass, entities, self._state_changed)
+        self._schedule()
+        return True
+
+    @callback
+    def async_close(self):
+        self._closed = True
+        self._detach()
+        self._session.view.close()
+        if self._task is not None:
+            self._task.cancel()
+
+    def _detach(self):
+        if self._unlisten is not None:
+            self._unlisten()
+            self._unlisten = None
+        if self._timer is not None:
+            self._timer.cancel()
+            self._timer = None
+
+    @callback
+    def _state_changed(self, event):
+        if not self._session.is_active():
+            self.async_close()
+            return
+        self._session.view.changed(event.data["entity_id"])
+        self._schedule()
+
+    def _schedule(self):
+        if self._closed or self._task is not None or self._timer is not None:
+            return
+        if (ready := self._session.view.ready_at) is not None:
+            loop = self._hass.loop
+            self._timer = loop.call_at(max(ready, loop.time()), self._start_flush)
+
+    @callback
+    def _start_flush(self):
+        self._timer = None
+        self._task = self._entry.async_create_task(self._hass, self._flush(), "handheld state reply")
+        self._task.add_done_callback(self._flushed)
+
+    async def _flush(self):
+        async with asyncio.timeout(2):
+            await self._session.flush(self._hass.loop.time())
+
+    @callback
+    def _flushed(self, task):
+        self._task = None
+        error = None if task.cancelled() else task.exception()
+        if self._closed:
+            return
+        if error is not None:
+            LOGGER.debug("Handheld state sender failed: %s", type(error).__name__)
+            self.async_close()
+        elif not self._session.is_active():
+            self.async_close()
+        else:
+            self._schedule()
