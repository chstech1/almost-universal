+    event.code = 52;
+    factory(&event);
+    spec.count = 0;                /* Native parent owns its child. */
+    event.code = 46;
+    factory(&event);
+    CHECK(spec.count == 1 && !proof_timer.callback && spec.event_count == 0);
+
+    notice_page_payload[1] = (uintptr_t)&container;
+    const char *names[] = {stock_fan_name, stock_audio_name};
+    const char *texts[] = {"Fan profile unavailable\nBack to return", "Audio profile unavailable\nBack to return"};
+    for (unsigned i = 0; i < 4; ++i) {
+        unsigned device = i % 2;
+        spec.count = spec.event_count = 0;
+        notice_callback = stock_page_callback(17 + device);
+        CHECK(notice_callback != NULL);
+        active_page = names[device];
