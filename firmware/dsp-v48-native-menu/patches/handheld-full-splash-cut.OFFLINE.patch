+def references(dsp, start, end):
+    """All address-shaped words, including unaligned instruction overlaps."""
+    return {offset: value - BASE for offset in range(len(dsp) - 3)
+            if start <= (value := unpack_from("<I", dsp, offset)[0]) - BASE < end}
+
+
+def entry_calls(dsp, target):
+    result = []
+    for offset in range(RAM_COPY - 2):
+        if dsp[offset] & 0x3f not in (5, 0x15, 0x25, 0x35):
+            continue
+        encoded = int.from_bytes(dsp[offset:offset + 3], "little") >> 6
+        displacement = encoded - 0x40000 if encoded >= 0x20000 else encoded
+        if (offset & ~3) + 4 + 4 * displacement == target:
+            result.append(offset)
+    return result
+
