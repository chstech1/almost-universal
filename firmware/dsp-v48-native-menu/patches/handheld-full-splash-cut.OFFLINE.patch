+static int check_splash_pixels(void)
+{
+    static const unsigned expected[3][4] = {{77,44,88,145}, {41,200,160,28}, {20,233,200,27}};
+    static const uint8_t bgra[] = {
+        0x2a,0x15,0x0a,255, 0xf2,0xf7,0xfa,255, 0xfe,0xdc,0x50,255, 0x90,0x88,0x84,255
+    };
+    static const uint16_t native565[] = {0xa508, 0xbeff, 0xff56, 0x5284};
+    uint16_t palette[3][4];
+    uint8_t alpha[3][4];
+    for (unsigned i = 0; i < 3; ++i) {
+        const struct layout_label *crop = &layout_labels[FirstCrop + i];
+        CHECK(crop->image && !crop->hidden && crop->x == (int)expected[i][0] &&
+              crop->y == (int)expected[i][1]);
+        uint32_t w = expected[i][2], h = expected[i][3];
+        CHECK(crop->image->header == (8 | w << 10 | h << 21) &&
+              crop->image->data_size == 16 + w * h / 4);
+        for (unsigned j = 0; j < sizeof bgra; ++j)
+            CHECK(crop->image->data[j] == bgra[j]);
+        CHECK(stock_indexed_palette(crop->image, palette[i], alpha[i]) == 1);
+        for (unsigned j = 0; j < 4; ++j)
+            CHECK(palette[i][j] == native565[j] && alpha[i][j] == 255);
+    }
+    CHECK(panel_bg == native565[0] && color_matches(panel_bg, 0x08a5));
+    uint16_t composite[240];
+    uint8_t rgba_row[200 * 3];
+    for (unsigned y = 0; y < 320; ++y) {
+        for (unsigned x = 0; x < 240; ++x)
+            composite[x] = panel_bg;
+        for (unsigned i = 0; i < 3; ++i) {
+            unsigned x = expected[i][0], top = expected[i][1];
+            unsigned w = expected[i][2], h = expected[i][3];
+            if (y < top || y >= top + h)
+                continue;
+            stock_indexed_row(layout_labels[FirstCrop + i].image, 16 + (y-top) * (w/4), w,
+                              palette[i], alpha[i], rgba_row);
+            for (unsigned j = 0; j < w; ++j) {
+                CHECK(rgba_row[3*j+2] == 255);
+                composite[x+j] = rgba_row[3*j] | (unsigned)rgba_row[3*j+1] << 8;
+            }
+        }
+        for (unsigned x = 0; x < 240; ++x) {
+            unsigned pixel = y * 240 + x;
+            unsigned index = (original_splash_pixels[pixel/4] >> (6 - 2*(x&3))) & 3;
+            CHECK(composite[x] == native565[index]);
+        }
+    }
+    return 0;
+}
