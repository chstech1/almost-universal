+        CHECK(groups_deleted == i + 1 && !keypad_group && !wheel_group);
+        active_page = stock_nodev_name;
+        const uint32_t back = 0x40000;
+        const struct stock_event stale = {
+            .target = &container, .current_target = &container, .code = 13,
+            .user_data = notice_event.user_data, .parameter = &back
+        };
+        notice_event.callback(&stale);
+        CHECK(closed_notice == i + 1);
+    }
+    spec.count = 2;
+    children[0] = &icon;
+    children[1] = &label;
+    spec.event_count = 0;
