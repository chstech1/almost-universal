+"""Generate lossless native 2 bpp crops from the pinned 240 × 320 splash."""
+
+from hashlib import sha256
+
+from PIL import Image
+
+
+ART_SHA = "9ef6c703149eaccc16ee07a4c1d402f24e4a565ddf0a4eded836e144c4a33554"
+COLORS = tuple(bytes.fromhex(hex_rgb) for hex_rgb in ("0a152a", "faf7f2", "50dcfe", "848890"))
+CROPS = ((77, 44, 88, 145), (41, 200, 160, 28), (20, 233, 200, 27))
+
+
+def pack_2bpp(indices):
+    return bytes((a << 6) | (b << 4) | (c << 2) | d
+                 for a, b, c, d in zip(indices[::4], indices[1::4], indices[2::4], indices[3::4]))
+
+
+def compress(raw):
+    """Optimal byte count for literal blocks and 256-byte-window back references."""
+    end = len(raw)
+    costs = [0] * (end + 1)
+    choices = [None] * end
+    for at in range(end - 1, -1, -1):
+        count = min(range(1, min(128, end - at) + 1), key=lambda n: n + costs[at + n])
+        best = (1 + count + costs[at + count], count, 0)
+        longest = 2
+        limit = min(130, end - at)
+        for distance in range(1, min(256, at) + 1):
+            source = at - distance
+            length = 0
+            while length < limit and raw[at + length] == raw[source + length]:
+                length += 1
+            if length > longest:
+                count = min(range(longest + 1, length + 1), key=lambda n: costs[at + n])
+                option = (2 + costs[at + count], count, distance)
+                best = min(best, option)
+                longest = length
+                if length == limit:
+                    break
+        costs[at] = best[0]
+        choices[at] = best[1:]
+    packed = bytearray()
+    at = 0
+    while at < end:
+        count, distance = choices[at]
+        if distance:
+            packed.extend((0x80 | (count - 3), distance - 1))
+        else:
+            packed.append(count - 1)
+            packed.extend(raw[at:at + count])
+        at += count
+    return bytes(packed)
+
+
+def decompress(packed):
+    """Independent check of the generator output before compiling target code."""
+    pixels = bytearray()
+    at = 0
+    while at < len(packed):
+        token = packed[at]
+        at += 1
+        if token & 0x80:
+            distance = packed[at] + 1
+            at += 1
+            for _ in range((token & 0x7f) + 3):
+                pixels.append(pixels[-distance])
+        else:
+            count = token + 1
+            pixels.extend(packed[at:at + count])
+            at += count
+    return bytes(pixels)
+
+
+def c_array(name, data):
+    lines = [f"static const uint8_t {name}[] = {{"]
+    for at in range(0, len(data), 16):
+        lines.append("    " + " ".join(f"0x{value:02x}," for value in data[at:at + 16]))
+    return "\n".join([*lines, "};"])
+
+
+def prepare(approved, work):
+    if sha256(approved.read_bytes()).hexdigest() != ART_SHA:
+        raise SystemExit("Expected the exact approved four-color splash PNG")
+    with Image.open(approved) as image:
+        rgb = image.convert("RGB")
+    if rgb.size != (240, 320) or set(rgb.get_flattened_data()) != {tuple(color) for color in COLORS}:
+        raise SystemExit("Unexpected splash dimensions or colors")
+    lookup = {tuple(color): index for index, color in enumerate(COLORS)}
+    original = bytes(lookup[color] for color in rgb.get_flattened_data())
+    canvas = bytearray(240 * 320)
+    palette = b"".join(color[::-1] + b"\xff" for color in COLORS)
+    header = [c_array("splash_palette", palette)]
+    sizes = []
+    for index, (x, y, width, height) in enumerate(CROPS):
+        indices = bytes(lookup[color] for color in rgb.crop((x, y, x + width, y + height)).get_flattened_data())
+        raw = pack_2bpp(indices)
+        packed = compress(raw)
+        restored = decompress(packed)
+        if restored != raw:
+            raise SystemExit("The packed splash data failed round-trip verification")
+        decoded = bytes((value >> shift) & 3 for value in restored for shift in (6, 4, 2, 0))
+        for row in range(height):
+            start = (y + row) * 240 + x
+            canvas[start:start + width] = decoded[row * width:(row + 1) * width]
+        sizes.append(len(packed))
+        header.append(c_array(f"splash_crop_{index}", packed))
+    if canvas != original:
+        raise SystemExit("The decoded crops and navy matte differ from the approved frame")
+    header.append("static const struct packed_crop splash_crops[] = {")
+    header.extend(f"    {{splash_crop_{i}, sizeof splash_crop_{i}, {x}, {y}, {w}, {h}}},"
+                  for i, (x, y, w, h) in enumerate(CROPS))
+    header.append("};")
+    (work / "splash_packed.inc").write_text("\n".join(header) + "\n")
+    (work / "splash_expected.bin").write_bytes(pack_2bpp(original))
+    print(f"Full-frame pixel proof: 76,800 identical pixels. Crop streams {sizes}, {sum(sizes)} bytes.", flush=True)
