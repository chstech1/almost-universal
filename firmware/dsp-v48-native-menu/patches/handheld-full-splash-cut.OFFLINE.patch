+__attribute__((section(".retired_dump")))
+bool unpack_splash(uint8_t *pixels, size_t size, const uint8_t *stream, size_t length)
+{
+    uint8_t *out = pixels;
+    uint8_t *end = out + size;
+    const uint8_t *limit = stream + length;
+    while (stream != limit) {
+        unsigned token = *stream++;
+        size_t count = (token & 0x7f) + 1;
+        if (token & 0x80) {
+            count += 2;
+            if (stream == limit || count > (size_t)(end - out))
+                return false;
+            size_t distance = *stream++ + 1;
+            if (distance > (size_t)(out - pixels))
+                return false;
+            const uint8_t *previous = out - distance;
+            while (count--)
+                *out++ = *previous++;
+        } else {
+            if (count > (size_t)(limit - stream) || count > (size_t)(end - out))
+                return false;
+            while (count--)
+                *out++ = *stream++;
+        }
+    }
+    return out == end;
+}
