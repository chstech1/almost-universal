+        keypad_group = &group;
+        wheel_group = &group;
+        notice_lifecycle(52);
+        CHECK(keypad_group == &group && wheel_group == &group && groups_deleted == i);
+        notice_lifecycle(45);
+        notice_lifecycle(46);
+        notice_lifecycle(46);
+        CHECK(groups_created == i + 1 && keypad_group == &notice_group && !wheel_group &&
+              spec.count == 1 && equal(layout_labels[0].text, texts[device]));
+        keypad_group = NULL;
+        notice_lifecycle(47);
+        CHECK(keypad_group == &notice_group);
+        stock_group_send(&notice_group, 0x200); /* A performs no retired action. */
+        CHECK(closed_notice == i && returned_home == i);
+        stock_group_send(&notice_group, 0x04000000);
+        CHECK(returned_home == i + 1);
+        stock_group_send(&notice_group, 0x40000);
+        CHECK(closed_notice == i + 1 && sent == 0);
+        notice_lifecycle(52);
