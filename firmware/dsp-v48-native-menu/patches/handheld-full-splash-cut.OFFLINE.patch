+__attribute__((section(".retired_audio")))
+static void device_notice(const struct stock_event *event, struct notice_state *notice,
+                          const char *text)
+{
+    switch (event->code) {
+    case 0x2e: {  /* Page manager's create event. Parameter word 1 is its container. */
+        if (!event->parameter || !event->parameter[1] || notice->parent)
+            return;
+        void *container = (void *)(uintptr_t)event->parameter[1];
+        stock_set_size(container, 240, 320);
+        stock_bg_color(container, PANEL, MAIN);
+        stock_bg_opacity(container, 255, MAIN);
+        struct stock_label *label = stock_label_create(container);
+        if (label) {
+            stock_text_font(label, stock_compact_font, MAIN);
+            stock_text_color(label, PRIMARY, MAIN);
+            place(label, text, 14, 104, 212, 70);
+        }
+        notice->parent = container;
+        notice->group = stock_group_create();
+        if (notice->group)
+            stock_group_add(notice->group, container);
+        stock_event_add(container, notice_key, 13, notice);
+        stock_bind_group(stock_wheel(), NULL);
+        break;
+    }
+    case 0x2f:  /* Reactivate after a child page closes. */
+        break;
+    case 0x34:  /* Destroy the private group before releasing the container. */
+        if (!notice->parent)
+            return;
+        if (notice->group)
+            stock_group_delete(notice->group);
+        stock_bind_group(stock_keypad(), NULL);
+        stock_bind_group(stock_wheel(), NULL);
+        notice->group = NULL;
+        notice->parent = NULL;
+        return;
+    default:
+        return;
+    }
+    if (notice->group)
+        stock_bind_group(stock_keypad(), notice->group);
+}
