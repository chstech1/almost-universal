+static void notice_key(const struct stock_event *event)
+{
+    const struct notice_state *notice = (const void *)event->user_data;
+    if (!event->parameter || !notice || event->target != notice->parent ||
+        !stock_page_manager ||
+        stock_active_page() != (notice == &stock_audio_notice ? stock_audio_name : stock_fan_name))
+        return;
+    switch (*event->parameter) {
+    case 0x00040000:  /* Hard Back */
+        stock_close_page();
+        break;
+    case 0x04000000:  /* Hard Home */
+        stock_return_home();
+        break;
+    }
+}
