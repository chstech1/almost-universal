+__attribute__((noinline, section(".retired_audio")))
+static void draw_battery(struct stock_label *label)
+{
+    unsigned icon = handheld_state.battery_icon;
+    if (icon) {
+        stock_text_align(label, CENTER_ALIGN, MAIN);
+        stock_text_color(label, icon & 8 ? BATTERY_LOW : SECONDARY, MAIN);
+        place(label, battery_glyphs[(icon & 7) - 1], 198, 22, 28, 18);
+    } else {
+        stock_add_flag(label, HIDDEN);
+    }
+}
+
+extern void stock_update_battery(uint8_t percent);
+
+__attribute__((section(".retired_audio")))
+void activities_battery_status(uint8_t percent)
+{
+    stock_update_battery(percent);
+    unsigned icon = 0;
+    if (percent <= 100) {
+        icon = 1 + (percent >= 13) + (percent >= 38) + (percent >= 63) + (percent >= 88);
+        if (percent <= 20)
+            icon |= 8;
+    }
+    if (icon == handheld_state.battery_icon)
+        return;
+    handheld_state.battery_icon = icon;
+    if (handheld_state.startup == SPLASH_SHOWN && handheld_state.view == ACTIVITIES && nodev_active()) {
+        struct stock_label *label = stock_get_child(stock_nodev.container, FEEDBACK_CHILD);
+        if (label)
+            draw_battery(label);
+    }
+}
