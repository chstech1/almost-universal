+/* Snapshot the prior menu cookie before relocation. Keep only its match flag. */
+.section .wake_entry,"ax",@progbits
+.p2align 2
+state_address: .word handheld_state
+cookie_value: .word 0x5736          /* WAKE_COOKIE, checked by the menu fixture */
+.global wake_entry
+wake_entry:
+    entry a1, 32
+    l32r a3, state_address
+    memw
+    l16ui a4, a3, 2
+    call8 stock_relocate
+    l32r a5, cookie_value
+    bne a4, a5, done
+    movi a4, 0x40                   /* wake_retained bit in cleared first byte */
+    s8i a4, a3, 0
+done:
+    retw.n
